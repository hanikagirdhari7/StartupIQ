# StartupIQ — example environment file.
#
# Copy this to .env (git-ignored) and fill in what your provider needs, then
# start the API with: npm run server
#
# The .env is loaded by Node itself (--env-file-if-exists), so it is only read
# when the server process starts: restart the server after editing it.
# Never commit a real key, and never put any of these values in frontend code —
# everything here is server-side, and nothing here is sent to the browser.
#
# Leave AI_PROVIDER=none to run the app with no AI at all: the form still
# validates and the API answers, but with `analysis: null` instead of a report.

# Which AI provider answers an analysis: gemini | ollama | openai-compatible | none
AI_PROVIDER=none

# --- gemini ------------------------------------------------------------------
# From AI Studio. Free tier allows only a small number of requests per day, and
# every visitor shares this one key, so keep it private and watch the quota.
# Get one: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- ollama (local) ----------------------------------------------------------
# OLLAMA_MODEL is optional: with it empty the server picks an installed model.
# Note that a useful local model needs far more RAM than a small machine has.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# --- any other OpenAI-compatible endpoint (LM Studio, vLLM, hosted gateways) ---
AI_BASE_URL=http://localhost:1234/v1
AI_MODEL=
# Only set this if that server requires auth; local servers usually need none.
AI_API_KEY=

# --- timing ------------------------------------------------------------------
# How long the server waits for one generation before giving up. Keep it below
# REQUEST_TIMEOUT_MS in src/services/api.js (150000) — the browser stops waiting
# there, and raising only this value means the page gives up on an analysis that
# was still going to succeed.
AI_TIMEOUT_MS=60000
# Availability probe timeout for local runtimes — keep it short so a machine
# that is not running answers "unavailable" quickly instead of hanging.
AI_PROBE_TIMEOUT_MS=1500

# --- API server --------------------------------------------------------------
# Port for the Express API. The Vite dev server proxies /api here (vite.config.js).
PORT=3001
